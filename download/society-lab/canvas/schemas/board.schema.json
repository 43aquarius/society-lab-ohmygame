{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "viewport",
    "nodes",
    "edges",
    "id"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 240,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 240,
          "maximum": 8192
        }
      }
    },
    "nodes": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "type": {
                "const": "document"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "documentId"
                ],
                "properties": {
                  "documentId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "type": {
                "const": "text"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "instruction"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "instruction": {
                    "type": "string"
                  },
                  "model": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "provider",
                      "id"
                    ],
                    "properties": {
                      "provider": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "type": {
                "const": "image"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "prompt",
                  "resolution",
                  "aspectRatio",
                  "images"
                ],
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "promptSource": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "nodeId"
                    ],
                    "properties": {
                      "type": {
                        "const": "node"
                      },
                      "nodeId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      }
                    }
                  },
                  "model": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "provider",
                      "id"
                    ],
                    "properties": {
                      "provider": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      }
                    }
                  },
                  "resolution": {
                    "enum": [
                      "512",
                      "1K",
                      "2K",
                      "4K"
                    ]
                  },
                  "aspectRatio": {
                    "enum": [
                      "1:1",
                      "2:3",
                      "3:2",
                      "3:4",
                      "4:3",
                      "4:5",
                      "5:4",
                      "9:16",
                      "16:9",
                      "21:9"
                    ]
                  },
                  "images": {
                    "type": "array",
                    "maxItems": 14,
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "assetId"
                          ],
                          "properties": {
                            "type": {
                              "const": "library"
                            },
                            "assetId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 120
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "nodeId"
                          ],
                          "properties": {
                            "type": {
                              "const": "node"
                            },
                            "nodeId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 120
                            }
                          }
                        }
                      ]
                    }
                  },
                  "assetId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "type": {
                "const": "video"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "prompt",
                  "resolution",
                  "aspectRatio",
                  "duration",
                  "references"
                ],
                "properties": {
                  "prompt": {
                    "type": "string"
                  },
                  "promptSource": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "nodeId"
                    ],
                    "properties": {
                      "type": {
                        "const": "node"
                      },
                      "nodeId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      }
                    }
                  },
                  "model": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "provider",
                      "id"
                    ],
                    "properties": {
                      "provider": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      }
                    }
                  },
                  "resolution": {
                    "enum": [
                      "480p",
                      "720p",
                      "768p",
                      "1080p",
                      "1K",
                      "2K",
                      "4K"
                    ]
                  },
                  "aspectRatio": {
                    "enum": [
                      "adaptive",
                      "21:9",
                      "16:9",
                      "4:3",
                      "3:2",
                      "1:1",
                      "2:3",
                      "3:4",
                      "9:16",
                      "9:21"
                    ]
                  },
                  "duration": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  },
                  "references": {
                    "type": "array",
                    "maxItems": 30,
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "assetId"
                          ],
                          "properties": {
                            "type": {
                              "const": "library"
                            },
                            "assetId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 120
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "nodeId"
                          ],
                          "properties": {
                            "type": {
                              "const": "node"
                            },
                            "nodeId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 120
                            }
                          }
                        }
                      ]
                    }
                  },
                  "referenceMode": {
                    "enum": [
                      "frame",
                      "reference"
                    ]
                  },
                  "referenceMentions": {
                    "type": "object",
                    "patternProperties": {
                      "^Image[1-9][0-9]*$": {
                        "oneOf": [
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "type",
                              "assetId"
                            ],
                            "properties": {
                              "type": {
                                "const": "library"
                              },
                              "assetId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 120
                              }
                            }
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "type",
                              "nodeId"
                            ],
                            "properties": {
                              "type": {
                                "const": "node"
                              },
                              "nodeId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 120
                              }
                            }
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  },
                  "assetId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "type": {
                "const": "model-3d"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "targetPolycount",
                  "texture",
                  "pbr",
                  "images"
                ],
                "properties": {
                  "model": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "provider",
                      "id"
                    ],
                    "properties": {
                      "provider": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      }
                    }
                  },
                  "targetPolycount": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 300000
                  },
                  "texture": {
                    "type": "boolean"
                  },
                  "pbr": {
                    "type": "boolean"
                  },
                  "images": {
                    "type": "array",
                    "maxItems": 4,
                    "items": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "assetId"
                          ],
                          "properties": {
                            "type": {
                              "const": "library"
                            },
                            "assetId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 120
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "type",
                            "nodeId"
                          ],
                          "properties": {
                            "type": {
                              "const": "node"
                            },
                            "nodeId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 120
                            }
                          }
                        }
                      ]
                    }
                  },
                  "assetId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "type": {
                "const": "animate-3d"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "heightMeters",
                  "actionIds"
                ],
                "properties": {
                  "source": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "assetId"
                        ],
                        "properties": {
                          "type": {
                            "const": "library"
                          },
                          "assetId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "nodeId"
                        ],
                        "properties": {
                          "type": {
                            "const": "node"
                          },
                          "nodeId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 120
                          }
                        }
                      }
                    ]
                  },
                  "heightMeters": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 100
                  },
                  "actionIds": {
                    "type": "array",
                    "maxItems": 30,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "assetId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "type": {
                "const": "asset"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "description": {
                "type": "string",
                "maxLength": 2000
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "assetId",
                  "mediaType"
                ],
                "properties": {
                  "assetId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "mediaType": {
                    "enum": [
                      "image",
                      "video",
                      "audio",
                      "model"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 8000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "sourceHandle": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
    }
  }
}
