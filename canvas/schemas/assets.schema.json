{
  "type": "object",
  "required": [
    "version",
    "assets"
  ],
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "assets": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_-]{1,120}$": {
          "type": "object",
          "required": [
            "name",
            "path"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+"
            },
            "description": {
              "type": "string",
              "maxLength": 2000
            },
            "prompt": {
              "type": "string"
            },
            "libraryAssetId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "additionalProperties": false
        }
      },
      "maxProperties": 10000
    }
  },
  "additionalProperties": false
}
